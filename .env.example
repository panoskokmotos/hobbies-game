# Butterbase backend client config. Optional — defaults to the values baked
# into src/lib/butterbase.js if unset. Set these to point dev/staging/prod at
# different Butterbase apps.
VITE_BUTTERBASE_APP_ID=
VITE_BUTTERBASE_API_URL=

# There is intentionally no VITE_ANTHROPIC_API_KEY here. Vite inlines VITE_*
# vars into the client bundle, so a paid LLM API key behind that prefix would
# ship to every visitor's browser and be fully extractable via devtools. Until
# recommendations are served through a backend proxy that holds the key
# server-side, src/lib/api.js's getRecommendations() always returns the
# curated fallback set. Do not add VITE_ANTHROPIC_API_KEY back without also
# adding that proxy.

# Web Push VAPID public key (safe to expose client-side — unlike the
# Anthropic key above, VAPID public keys are meant to be public). Required
# for ProfileScreen's "Enable notifications" to actually subscribe to push
# (src/lib/push.js) rather than just requesting browser permission with
# nothing to subscribe to. Generate a VAPID key pair (e.g. `npx web-push
# generate-vapid-keys`) and put the private key wherever your backend push-
# sending function lives — never in a VITE_-prefixed var.
VITE_VAPID_PUBLIC_KEY=
